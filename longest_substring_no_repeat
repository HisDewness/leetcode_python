# Given a string s, find the length of the longest
# substring without duplicate characters.
class Solution:
    def lengthOfLongestSubstring(self, s: str) -> int:
        # Establishing our return
        final_answer = 0

        # The current run of unique characters
        seen_chars = []

        for c in range(len(s)):
            # If we've seen this character, drop characters from the FRONT
            # of our tracker until the old copy is gone
            while s[c] in seen_chars:
                seen_chars.pop(0)

            # Now it's safe to add the current character
            seen_chars.append(s[c])

            # Keep the biggest run we've ever had
            if len(seen_chars) > final_answer:
                final_answer = len(seen_chars)

        # Return the final answer
        return final_answer